    <!-- http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Bomb -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Bomb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Bomb"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Bomb"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Release_Artifact_Function"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Bomb"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                        <owl:someValuesFrom rdf:resource="https://www.commoncoreontologies.org/ont00000841"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label>Aerial Bomb</rdfs:label>
        <skos:definition>An aerial bomb is a type of explosive (bomb) or incendiary weapon intended to be dropped from an aircraft and travel through the air on a predictable, unpowered trajectory.</skos:definition>
        <www:ont00001754>https://en.wikipedia.org/wiki/Aerial_bomb</www:ont00001754>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Release_Artifact_Function -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Aerial_Release_Artifact_Function">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000323"/>
        <rdfs:label>Aerial Release Artifact Function</rdfs:label>
        <skos:definition>An Artifact Function that is realized by a Material Artifact participating in an Aerial Release process.</skos:definition>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Bomb -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Bomb">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001150"/>
        <rdfs:label>Bomb</rdfs:label>
        <skos:definition>A bomb is an explosive weapon that uses the exothermic reaction of an explosive material to provied an extremely sudden and violent release of energy.</skos:definition>
        <www:ont00001754>https://en.wikipedia.org/wiki/Bomb</www:ont00001754>
    </owl:Class>
