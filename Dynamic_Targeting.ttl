                                    ] ;
                rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000544> ;
                rdfs:label "Dynamic Target" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A Target that is the object of an Act of Dynamic Targeting." ;
                <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" .


