###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Target_Decision
:Act_of_Target_Decision rdf:type owl:Class ;
                        rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000741> ;
                        rdfs:label "Act of Target Decision" ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "Targeting Phase" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "A Act of Targeting wherein a commander or component command operations center delects the appropriate weapon, platform, or asset to presecute an identified and tracked target and obtains the necessary authorities to engage." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Target_Engagement
:Act_of_Target_Engagement rdf:type owl:Class ;
                          rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000109> ;
                          rdfs:label "Act of Target Engagement" ;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "Engagement Phase" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "An Act of Military Force wherein kinetic or non-kinetic action is taken against a target." ;
                          <https://www.commoncoreontologies.org/ont00001745> "Joint Publication 3-60, Targeting" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Target_Location_Accuracy_Estimation
:Act_of_Target_Location_Accuracy_Estimation rdf:type owl:Class ;
                                            rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000078> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass :Target_Location_Identifier
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass :Target_Location_Accuracy
                                                            ] ;
                                            rdfs:label "Act of Target Location Accuracy Estimation" ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "An Act of Estimation in which a Circular Error 90% Measurement, and where available a Linear Error 90% Measurement, of a Target Location Identifier are used to produce a Target Location Error, which expresses how far the reported location of a target may differ from the target’s actual location." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Target_Location_Change
:Act_of_Target_Location_Change rdf:type owl:Class ;
                               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
