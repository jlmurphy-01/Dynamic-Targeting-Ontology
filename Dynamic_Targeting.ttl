                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an Entity's activities, disposition, intent, and/or resources; the composition and capabilities of Equipment and Facilities, and/or the meterological, hydrographic, or geographic characteristics of a particular area." ;
                                           <https://www.commoncoreontologies.org/ont00001754> "Department of Defense - Dictionary of Military and Associated Terms" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Restricted_Target_List
:Restricted_Target_List rdf:type owl:Class ;
                        rdfs:subClassOf :Target_List ;
                        rdfs:label "Restricted Target List" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "A list of restricted targets nominated by elements of the joint force and approved by the joint force commander or directed by higher authorities." ;
                        <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" ;
                        <https://www.commoncoreontologies.org/ont00001748> "RTL" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Target_Enagement_Authority_Role
:Target_Enagement_Authority_Role rdf:type owl:Class ;
                                 rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000187> ;
                                 rdfs:label "Target Enagement Authority Role" ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "TEA" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "An Authority Role that inheres in an Agent (typically a Commander or Command Node) by virtue of a directive or delegation process, and which is realized in a process of approving or authorizing the engagement of a designated target." ,
                                                                                  "An Authority Role that inheres in an Agent by virtue of a directive process and which is realized in a process of approving or authorizing the adjudication and determination of an ISR-derived target positive identification." .


