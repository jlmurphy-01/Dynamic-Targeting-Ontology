                                                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                                 owl:someValuesFrom :Target_Dwell_Time_Estimate_Information_Content_Entity
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                                 owl:someValuesFrom :Target_Engagement_Timeline_Estimate_Information_Content_Entity
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                                 owl:someValuesFrom :Target_Vulnerability_Window_Estimate_Information_Content_Entity
                                                               ] ;
                                               rdfs:label "Act of Target Vulnerability Window Estimation" ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "An Act of Estimation representing the predicted temporal interval or duration during which a target is exposed and susceptible to friendly engagement." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Tracking_Target
:Act_of_Tracking_Target rdf:type owl:Class ;
                        rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001251> ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                          owl:someValuesFrom :Act_of_Target_Decision
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                          owl:someValuesFrom :Act_of_Target_Location_Change
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                          owl:someValuesFrom :Intelligence_Analyst
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                          owl:someValuesFrom :Dynamic_Targeting_Plan_Prescription
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                          owl:someValuesFrom :Positive_Identification_Information_Content_Entity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                          owl:someValuesFrom :Reconnaissance_Information_Content_Entity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                          owl:someValuesFrom :Target_Track_Point_Information_Content_Entity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                          owl:someValuesFrom :Target_Track_Information_Content_Entity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                          owl:someValuesFrom :Target_Track_Status_Information_Content_Entity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                          owl:someValuesFrom :Target_Vulnerability_Window_Estimate_Information_Content_Entity
