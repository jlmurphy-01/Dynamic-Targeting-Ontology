                                                                               owl:someValuesFrom :Positive_Identification_Authority_Role
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                               owl:someValuesFrom :Senior_Intelligence_Duty_Officer_Role
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
                                  rdfs:label "Senior Intelligence Duty Officer" ;
                                  <https://www.commoncoreontologies.org/ont00001749> "SIDO" ;
                                  <https://www.commoncoreontologies.org/ont00001754> "A Person who is the bearer of the Senior Intellgence Duty Officer Role" ,
                                                                                     "AFMAN13-1 AOC Volume 3" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Senior_Intelligence_Duty_Officer_Role
:Senior_Intelligence_Duty_Officer_Role rdf:type owl:Class ;
                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000984> ;
                                       rdfs:label "Senior Intelligence Duty Officer Role" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "An Occupation Role that is the senior intelligence officer assigned to the Combat Operations Division within the operations floor of the US Air Force Air Operations Center." ;
                                       <https://www.commoncoreontologies.org/ont00001745> "AFMAN13-1 AOC Volume 3" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Special_Instructions
:Special_Instructions rdf:type owl:Class ;
                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
                      rdfs:label "Special Instructions" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A Process Regulation that provide an airspace user with directions to balance combat effectiveness with safe, orderly, and efficient use of airspace, and provides operational and tactical direction at the appropriate levels of detail." ;
                      <https://www.commoncoreontologies.org/ont00001749> "SPINS" ;
                      <https://www.commoncoreontologies.org/ont00001754> "https://www.doctrine.af.mil/Portals/61/documents/AFDP_3-52/3-52-AFDP-AIRSPACE-CONTROL.pdf" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Target_Dwell_Interval
:Target_Dwell_Interval rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
                       rdfs:label "Target Dwell Interval" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A Temporal Interval that is occupied by a process in which a target remains stationary at a specific location or persists in an active operational state." ;
                       <http://www.w3.org/2004/02/skos/core#example> "Bounded by the target's arrival or activation at a site and its subsequent departure, concealment, or shutdown, this interval represents the physical temporal span of adversary exposure measured by a Target Dwell Time Estimate." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Target_Dwell_Time_Estimate_Information_Content_Entity
:Target_Dwell_Time_Estimate_Information_Content_Entity rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000745> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://www.commoncoreontologies.org/ont00001966> ;
                                                                         owl:someValuesFrom :Target_Dwell_Interval
                                                                       ] ;
                                                       rdfs:label "Target Dwell Time Estimate Information Content Entity" ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "A Point Estimate Information Content Entity that is a measurement of the predicted or approximated duration of a temporal region occupied by a target remaining in a specific location or operational state." ;
                                                       <http://www.w3.org/2004/02/skos/core#example> "This estimate is typically derived from Intelligence Preparation of the Battlespace (IPB), pattern-of-life analysis, or known adversary system operating cycles (such as setup, firing/emission, and teardown times) to establish the upper bound of target exposure." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Target_Engagement_Authority_Role
:Target_Engagement_Authority_Role rdf:type owl:Class ;
                                  rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000187> ;
                                  rdfs:label "Target Enagement Authority Role" ;
                                  <http://www.w3.org/2004/02/skos/core#altLabel> "TEA" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "An Authority Role that inheres in an Agent (typically a Commander or Command Node) by virtue of a directive or delegation process, and which is realized in a process of approving or authorizing the engagement of a designated target." ,
                                                                                   "An Authority Role that inheres in an Agent by virtue of a directive process and which is realized in a process of approving or authorizing the adjudication and determination of an ISR-derived target positive identification." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Target_Engagement_Timeline_Estimate_Information_Content_Entity
:Target_Engagement_Timeline_Estimate_Information_Content_Entity rdf:type owl:Class ;
                                                                rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000745> ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001966> ;
                                                                                  owl:someValuesFrom :Target_Engagement_Timeline_Interval
                                                                                ] ;
                                                                rdfs:label "Target Engagement Timeline Estimate Information Content Entity" ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "A Point Estimate Information Content Entity that is a measurement of the predicted or approximated duration required for friendly forces to complete the remaining phases of a target engagement process from identification to weapon impact." ;
                                                                <http://www.w3.org/2004/02/skos/core#example> "This estimate aggregates kill-chain latencies, including finding, fixing, command and control (C2) approval, advnaced target development, platform transit, and munition time-of-flight, to determine whether a strike can be executed before a target conceals itself or relocates." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Target_Engagement_Timeline_Interval
:Target_Engagement_Timeline_Interval rdf:type owl:Class ;
                                     rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
                                     rdfs:label "Target Engagement Timeline Interval" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A Temporal Interval spanning from the initiation of target processing or positive identification through weapon delivery and impact on the target." ;
                                     <http://www.w3.org/2004/02/skos/core#example> "This interval represents the continuous temporal footprint of the friendly kill-chain execution including the Find, Fix,  Track, Target, and Engage phases of F2T2EA." .


