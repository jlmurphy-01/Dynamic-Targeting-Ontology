@prefix : <http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/> .

<http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting> rdf:type owl:Ontology ;
                                                                       owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ,
                                                                                   <https://www.commoncoreontologies.org/2026-08-13/CommonCoreOntologiesMerged> .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Identifying_Entity_Type
:Act_of_Identifying_Entity_Type rdf:type owl:Class ;
                                rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001261> ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                                  owl:someValuesFrom [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001017>
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                                              owl:someValuesFrom :Intelligence_Analyst_Role
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ]
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                  owl:someValuesFrom :Reconnaissance_Information_Content_Entity
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                  owl:someValuesFrom :Entity_Type_Identification_Information_Content_Entity
                                                ] ;
                                rdfs:label "Act of Identifying Entity Type" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Positive_Identification
:Act_of_Positive_Identification rdf:type owl:Class ;
                                owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001261>
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                             owl:someValuesFrom :Act_of_Identifying_Entity_Type
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                             owl:someValuesFrom :Act_of_Positive_Identification_Determination
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                             owl:someValuesFrom :Act_of_Identifying_Allegiance
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ;
                                rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001261> ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                  owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000320>
                                                ] ;
                                rdfs:label "Act of Positive Identification" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Positive_Identification_Determination
:Act_of_Positive_Identification_Determination rdf:type owl:Class ;
                                              rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000351> ,
                                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                                       owl:someValuesFrom :Act_of_Identifying_Entity_Type
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                                       owl:someValuesFrom :Act_of_Identifying_Allegiance
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ,
                                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                                                       owl:someValuesFrom :Senior_Intelligence_Duty_Office
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                                                       owl:allValuesFrom [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001262>
                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                                                                                  owl:someValuesFrom :Positive_Identification_Authority_Role
                                                                                                                                ]
                                                                                                                              ) ;
                                                                                                           rdf:type owl:Class
                                                                                                         ]
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ,
                                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                                                       owl:someValuesFrom :Allegiance_Identification_Information_Content_Entity
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                                                       owl:someValuesFrom :Entity_Type_Identification_Information_Content_Entity
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ,
                                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                                                       owl:someValuesFrom :Rules_of_Engagement
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                                                       owl:someValuesFrom :Special_Instructions
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ;
                                              rdfs:label "Act of Positive Identification Determination" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Allegiance_Identification_Information_Content_Entity
:Allegiance_Identification_Information_Content_Entity rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                                      rdfs:label "Allegiance Identification Information Content Entity" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Entity_Type_Identification_Information_Content_Entity
:Entity_Type_Identification_Information_Content_Entity rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                                       rdfs:label "Entity Type Identification Information Content Entity" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Positive_Identification_Authority_Role
:Positive_Identification_Authority_Role rdf:type owl:Class ;
                                        rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000187> ;
                                        rdfs:label "Positive Identification Authority Role" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Postitive_Identification_Information_Content_Entity
:Postitive_Identification_Information_Content_Entity rdf:type owl:Class ;
                                                     owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00000853>
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                                                                ]
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001816> ;
                                                                                                  owl:someValuesFrom :Act_of_Positive_Identification_Determination
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                     rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                                     rdfs:label "Positive Identification Information Content Entity" ;
                                                     <https://www.commoncoreontologies.org/ont00001748> "A Descriptive Information Content Entity that describes an identification derived from observation and analysis of entity characteristics and meets certain criteria prescribed by a military authority." ,
                                                                                                        "PID" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Rules_of_Engagement
:Rules_of_Engagement rdf:type owl:Class ;
                     rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
                     rdfs:label "Rules of Engagement" ;
                     <https://www.commoncoreontologies.org/ont00001737> "A Process Regulation that represents directives issued by competent miltary authorities that delineate the circumstances and limiations under which US Forces will initiate and/or continue combat engagement with other foreces encountered." ;
                     <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" ;
                     <https://www.commoncoreontologies.org/ont00001749> "ROE" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Senior_Intelligence_Duty_Office
:Senior_Intelligence_Duty_Office rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001262>
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                              owl:someValuesFrom :Positive_Identification_Authority_Role
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                              owl:someValuesFrom :Senior_Intelligence_Duty_Officer_Role
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
                                 rdfs:label "Senior Intelligence Duty Officer" ;
                                 <https://www.commoncoreontologies.org/ont00001749> "SIDO" ;
                                 <https://www.commoncoreontologies.org/ont00001754> "A Person who is the bearer of the Senior Intellgence Duty Officer Role" ,
                                                                                    "AFMAN13-1 AOC Volume 3" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Senior_Intelligence_Duty_Officer_Role
:Senior_Intelligence_Duty_Officer_Role rdf:type owl:Class ;
                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000984> ;
                                       rdfs:label "Senior Intelligence Duty Officer Role" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "An Occupation Role that is the senior intelligence officer assigned to the Combat Operations Division within the operations floor of the US Air Force Air Operations Center." ;
                                       <https://www.commoncoreontologies.org/ont00001745> "AFMAN13-1 AOC Volume 3" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Special_Instructions
:Special_Instructions rdf:type owl:Class ;
                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
                      rdfs:label "Special Instructions" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A Process Regulation that provide an airspace user with directions to balance combat effectiveness with safe, orderly, and efficient use of airspace, and provides operational and tactical direction at the appropriate levels of detail." ;
                      <https://www.commoncoreontologies.org/ont00001749> "SPINS" ;
                      <https://www.commoncoreontologies.org/ont00001754> "https://www.doctrine.af.mil/Portals/61/documents/AFDP_3-52/3-52-AFDP-AIRSPACE-CONTROL.pdf" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Aerial_Release
:Act_of_Aerial_Release rdf:type owl:Class ;
                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
                       rdfs:label "Act of Aerial Release" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Act of Aerial Release in which some Agent drops, dispenses, or discharges a material artifact from an aircraft or elevated platform into the air." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Battle_Damage_Assessment
:Act_of_Battle_Damage_Assessment rdf:type owl:Class ;
                                 rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000636> ;
                                 rdfs:label "Act of Battle Damage Assessment" ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "BDA" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "An Act of Appraisal that estimates the physical and functional damage resulting from the application of lethal or nonlethal millitary force." ;
                                 <https://www.commoncoreontologies.org/ont00001745> "CJCSI 3160.02A" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Bomb_Hit_Indication
:Act_of_Bomb_Hit_Indication rdf:type owl:Class ;
                            rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000636> ;
                            rdfs:label "Act of Bomb Hit Indication" ;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "BHI" ;
                            <http://www.w3.org/2004/02/skos/core#definition> "An Act of Appraisal used to indicate the damage to or a change of the physical state of target." ;
                            <https://www.commoncoreontologies.org/ont00001745> "CJCSI 3160.02A" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Combat_Assessment
:Act_of_Combat_Assessment rdf:type owl:Class ;
                          rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000636> ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Battle_Damage_Assessment
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Bomb_Hit_Indication
                                          ] ;
                          rdfs:label "Act of Combat Assessment" ;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "CA" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "An Act of Appraisal which determines the overall effectiveness of force employment during military operations." ;
                          <https://www.commoncoreontologies.org/ont00001745> "CJCSI 3160.02A" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Dynamic_Target_Determination
:Act_of_Dynamic_Target_Determination rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00000351>
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                                  owl:someValuesFrom :Gain_of_Dynamic_Target_Role
                                                                                ]
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                                                  owl:someValuesFrom [ owl:intersectionOf ( :Dynamic_Target_Role
                                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                                                                                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                                                                                            ]
                                                                                                                          ) ;
                                                                                                       rdf:type owl:Class
                                                                                                     ]
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000351> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                                       owl:someValuesFrom [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000040>
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                                                   owl:someValuesFrom :Potential_Miltary_Target_Role
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ]
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000132> ;
                                                       owl:someValuesFrom :Act_of_Dynamic_Targeting
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                       owl:someValuesFrom [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001262>
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                                                   owl:someValuesFrom :Chief_Of_Combat_Operations_Role
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ]
                                                     ] ;
                                     rdfs:label "Act of Dynamic Target Determination" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Dynamic_Targeting
:Act_of_Dynamic_Targeting rdf:type owl:Class ;
                          rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000741> ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Combat_Assessment
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Finding_Target
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Fixing_Target
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Target_Decision
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Target_Engagement
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom :Act_of_Tracking_Target
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                            owl:someValuesFrom :Dynamic_Targeting_Plan_Prescription
                                          ] ;
                          rdfs:label "Act of Dynamic Targeting" ;
                          <https://www.commoncoreontologies.org/ont00001737> "An Act of Military Force that prosecutes military targets identified too late, or not selected for action in time to be included in deliberate targeting." ;
                          <https://www.commoncoreontologies.org/ont00001745> "Joint Publication 3-60, Targeting" ;
                          <https://www.commoncoreontologies.org/ont00001753> "DT" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Finding_Target
:Act_of_Finding_Target rdf:type owl:Class ;
                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001251> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                         owl:someValuesFrom :Act_of_Fixing_Target
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                         owl:someValuesFrom :Act_of_Identifying_Allegiance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                         owl:someValuesFrom :Act_of_Identifying_Potential_Target
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                         owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000320>
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                         owl:someValuesFrom :Dynamic_Targeting_Plan_Prescription
                                       ] ;
                       rdfs:label "Act of Finding Target" ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "Find Phase" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "An Act of Intelligence Gathering in which an entity is detected, classified, its allegiance determined, and evaluated against criteria to determine whether it is an potential military target." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Fixing_Target
:Act_of_Fixing_Target rdf:type owl:Class ;
                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001251> ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                        owl:someValuesFrom :Dynamic_Targeting_Plan_Prescription
                                      ] ;
                      rdfs:label "Act of Fixing Target" ;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "Fix Phase" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "An Act of Intelligence Gathering in which the military target's identity is confirmed, the location is determined with sufficient accuracy for an enagement decision, and a temoral window for engagement is estimated." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Identifying_Allegiance
:Act_of_Identifying_Allegiance rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001261>
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                            owl:someValuesFrom :Gain_of_Allegiance_Role
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001261> ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                                 owl:someValuesFrom [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001017>
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                                                             owl:someValuesFrom :Intelligence_Analyst_Role
                                                                                           ]
                                                                                         ) ;
                                                                      rdf:type owl:Class
                                                                    ]
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                 owl:someValuesFrom :Reconnaissance_Information_Content_Entity
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                 owl:someValuesFrom :Allegiance_Identification_Information_Content_Entity
                                               ] ;
                               rdfs:label "Act of Identifying Allegiance" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "An Act of Identifying in which an Agent uses a reconnaissance product describing an entity to determine to evaluate the entity's Allegiance (Enemy, Ally, Neutral) , resulting in that entity bearing Allegiance Role." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Identifying_Potential_Target
:Act_of_Identifying_Potential_Target rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001261>
                                                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                                                                         owl:someValuesFrom :Gain_of_Potential_Target_Role
                                                                                                       ]
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
