@prefix : <http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/> .

<http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting> rdf:type owl:Ontology ;
                                                                       owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ,
                                                                                   <https://www.commoncoreontologies.org/2026-08-13/CommonCoreOntologiesMerged> .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Advanced_Target_Development
:Act_of_Advanced_Target_Development rdf:type owl:Class ;
                                    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000511> ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                                      owl:someValuesFrom :Act_of_Target_Validation
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                      owl:someValuesFrom :Act_of_Collateral_Damage_Assessment
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                      owl:someValuesFrom :Act_of_Target_Coordinate_Mensuration
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                      owl:someValuesFrom :Act_of_Weaponeering
                                                    ] ;
                                    rdfs:label "Act of Advanced Target Development" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "An Act of Planning in which an Agent completes the target characterization process and defines the minimum intelligence necessary to plan for effective target engagement." ;
                                    <https://www.commoncoreontologies.org/ont00001745> "CJCSI3370.01B" ;
                                    <https://www.commoncoreontologies.org/ont00001749> "ATD" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Collateral_Damage_Assessment
:Act_of_Collateral_Damage_Assessment rdf:type owl:Class ;
                                     rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000078> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                       owl:someValuesFrom :Intelligence_Analyst
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                       owl:someValuesFrom :Joint_Desired_Point_of_Impact_Information_Content_Entity
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                       owl:someValuesFrom :Weaponeering_Solution_Information_Content_Entity
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                       owl:someValuesFrom :Collateral_Damage_Estimate_Information_Content_Entity
                                                     ] ;
                                     rdfs:label "Act of Collateral Damage Assessment" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "An Act of Estimation in which an Agent makes an analytic judgement derived by determining the amount and effects of collateral damage post target engagement." ;
                                     <https://www.commoncoreontologies.org/ont00001745> "CJCSI3162.02A" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Friendly_Asset_Selection
:Act_of_Friendly_Asset_Selection rdf:type owl:Class ;
                                 rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000511> ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                                   owl:someValuesFrom :Act_of_Target_Engagement_Decision
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                   owl:someValuesFrom :Chief_of_Combat_Operations
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                                   owl:someValuesFrom :Air_Operations_Directive
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                   owl:someValuesFrom :Friendly_Asset_List_Information_Content_Entity
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                   owl:someValuesFrom :Target_Validation_Decision_Information_Content_Entity
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                   owl:someValuesFrom :Weapon_Capability_Information_Content_Entity
                                                 ] ;
                                 rdfs:label "Act of Friendly Asset Selection" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "An Act of Planning in which an Agent selects one or more friendly operational assets, platforms, or units to execute or support an engagement plan against a target, based on target characteristics, weaponeering and collateral risk information, and asset availability and suitability." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Target_Coordinate_Mensuration
:Act_of_Target_Coordinate_Mensuration rdf:type owl:Class ;
                                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000345> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                                        owl:someValuesFrom :Act_of_Weaponeering
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                        owl:someValuesFrom :Intelligence_Analyst
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                        owl:someValuesFrom :Reconnaissance_Information_Content_Entity
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                                        owl:someValuesFrom :Target_Location_Identifier
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                        owl:someValuesFrom :Joint_Desired_Point_of_Impact_Information_Content_Entity
                                                      ] ;
                                      rdfs:label "Act of Target Coordinate Mensuration" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "An Act of Measuring in which an Agent uses NGA-validated tools and methods to produce coordinates (latitude, longitude and elevation), that include associated errors to support the use of coordinate-seeking weapons (CSWs)." ;
                                      <https://www.commoncoreontologies.org/ont00001745> "CJCSI 3505.01E" ;
                                      <https://www.commoncoreontologies.org/ont00001749> "TCM" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Target_Engagement_Decision
:Act_of_Target_Engagement_Decision rdf:type owl:Class ;
                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000351> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                     owl:someValuesFrom :Act_of_Advanced_Target_Development
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                     owl:someValuesFrom :Act_of_Friendly_Asset_Selection
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                                     owl:someValuesFrom :Act_of_Target_Validation
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                                     owl:someValuesFrom :Chief_of_Combat_Operations
                                                   ] ;
                                   rdfs:label "Act of Target Engagement Decision" ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "An Act of Commanding in which an authorized decision-maker evaluates target validation, advanced target development, and friendly asset selection information to formally approve or disapprove engaging a target, resulting in an engagement authorization or disapproval directive." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Target_Validation
:Act_of_Target_Validation rdf:type owl:Class ;
                          rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000636> ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                            owl:someValuesFrom :Act_of_Friendly_Asset_Selection
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                            owl:someValuesFrom [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00001194>
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                                                                        owl:someValuesFrom :Valid_Target_Role
                                                                                      ]
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ]
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Collateral_Damage_Estimate_Information_Content_Entity
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Collateral_Damage_Guidance_Information_Content_Entity
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Law_of_Armed_Conflict
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :No_Strike_List
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Weaponeering_Solution_Information_Content_Entity
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Air_Operations_Directive
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Joint_Target_List
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Operation_Plan
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Restricted_Target_List
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                            owl:someValuesFrom :Rules_of_Engagement
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                            owl:someValuesFrom :Target_Validation_Decision_Information_Content_Entity
                                          ] ;
                          rdfs:label "Act of Target Validation" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "An Act of Appraisal in which an Agent ensures all vetted targets meet the objectives and criteria outlined in the commander’s guidance and ensures compliance with the law of armed conflict and rules of engagement." ;
                          <https://www.commoncoreontologies.org/ont00001745> "CJCSI3370.01B" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Act_of_Weaponeering
:Act_of_Weaponeering rdf:type owl:Class ;
                     rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000511> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000063> ;
                                       owl:someValuesFrom :Act_of_Collateral_Damage_Assessment
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001833> ;
                                       owl:someValuesFrom :Intelligence_Analyst
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                       owl:someValuesFrom :Desired_Effect_Information_Content_Entity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                       owl:someValuesFrom :Joint_Desired_Point_of_Impact_Information_Content_Entity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001921> ;
                                       owl:someValuesFrom :Weapon_Capability_Information_Content_Entity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://www.commoncoreontologies.org/ont00001986> ;
                                       owl:someValuesFrom :Weaponeering_Solution_Information_Content_Entity
                                     ] ;
                     rdfs:label "Act of Weaponeering" ,
                                "An Act of Planning in which an Agent determines the quantity of a specific type of lethal or non-lethal weapons required to achieve a specific level of damage to a given target, considering target vulnerability, weapons characteristics and effects, and delivery parameters." ;
                     <https://www.commoncoreontologies.org/ont00001745> "CJCSI3370.01B" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Collateral_Damage_Estimate_Information_Content_Entity
:Collateral_Damage_Estimate_Information_Content_Entity rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001176> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                         owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000544>
                                                                       ] ;
                                                       rdfs:label "Collateral Damage Estimate Information Content Entity" ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "An Estimate Information Content Entity that records the potential unintentional or incidental injury or damage to persons or objects that would not be lawful military targets in the circumstances ruling at the time." ;
                                                       <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" ;
                                                       <https://www.commoncoreontologies.org/ont00001749> "CDE" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Collateral_Damage_Guidance_Information_Content_Entity
:Collateral_Damage_Guidance_Information_Content_Entity rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
                                                       rdfs:label "Collateral Damage Guidance Information Content Entity" ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "A Process Regulation that prescribes acceptable thresholds, mitigation standards, Non-combatant Casualty Cutoff Values (NCV), and approval authority levels governing unintended incidental damage to non-combatant persons or civilian/protected objects." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Desired_Effect_Information_Content_Entity
:Desired_Effect_Information_Content_Entity rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000127> ;
                                           rdfs:label "Desired Effect Information Content Entity" ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Performance Specification that prescribes the required physical, functional, or behavioral outcome to be achieved against a Target." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Friendly_Asset_Assignment_Information_Content_Entity
:Friendly_Asset_Assignment_Information_Content_Entity rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                        owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000544>
                                                                      ] ;
                                                      rdfs:label "Friendly Asset Assignment Information Content Entity" ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entitiy that designates a specific friendly asset, platform, or force package to be tasked against a Target to achieve a desired effect." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Friendly_Asset_List_Information_Content_Entity
:Friendly_Asset_List_Information_Content_Entity rdf:type owl:Class ;
                                                rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                                rdfs:label "Friendly Asset List Information Content Entity" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that enumerates and identifies friendly platforms, units, or weapon systems available for potential tasking." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Joint_Desired_Point_of_Impact_Information_Content_Entity
:Joint_Desired_Point_of_Impact_Information_Content_Entity rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000390> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                            owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000544>
                                                                          ] ;
                                                          rdfs:label "Joint Desired Point of Impact Information Content Entity" ;
                                                          <https://www.commoncoreontologies.org/ont00001737> "A Spatial Region Identifier the designates a unique, alpha-numeric coded precise aimpoint associated with a target to achieve an explicit weaponeering objective, and identified by a three dimensional (latitude, longitude, elevation) mensurated coordinate." ;
                                                          <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" ;
                                                          <https://www.commoncoreontologies.org/ont00001749> "JDPI" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Law_of_Armed_Conflict
:Law_of_Armed_Conflict rdf:type owl:Class ;
                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
                       rdfs:label "Law of Armed Conflict" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A Process Regulation that is the part of international law that regulates the conduct of armed hostilities." ;
                       <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" ;
                       <https://www.commoncoreontologies.org/ont00001749> "LOAC" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#No_Strike_List
:No_Strike_List rdf:type owl:Class ;
                rdfs:subClassOf :Target_List ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000040>
                                                                     <https://www.commoncoreontologies.org/ont00000472>
                                                                   )
                                                     ]
                                ] ;
                rdfs:label "No Strike List" ;
                <https://www.commoncoreontologies.org/ont00001749> "NSL" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Target_Validation_Decision_Information_Content_Entity
:Target_Validation_Decision_Information_Content_Entity rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                         owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000544>
                                                                       ] ;
                                                       rdfs:label "A Descriptive Information Content Entity stating whether the target meets intelligence accuracy, operational guidance, Law of Armed Conflict, Rules of Engagement, and restricted/no-strike compliance criteria." ,
                                                                  "Target Validation Decision Information Content Entity" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Valid_Target_Role
:Valid_Target_Role rdf:type owl:Class ;
                   rdfs:subClassOf :Military_Target_Role ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                                     owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000544>
                                   ] ;
                   rdfs:label "Valid Target Role" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A Military Target Role that is realized by a Process and inheres in a Material Entity, signifying that the bearer has been vetted against intelligence accuracy, operational guidance, Law of Armed Conflict, Rules of Engagement, and restricted/no-strike constraints and is legally and operationally eligible for engagement." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Weapon_Capability_Information_Content_Entity
:Weapon_Capability_Information_Content_Entity rdf:type owl:Class ;
                                              rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000445>
                                                              ] ;
                                              rdfs:label "Weapon Capability Information Content Entity" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "A Measurement Information Content Entity that quantifies empirical performance, lethality, accuracy, or reliability characteristics about a weapon." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting#Weaponeering_Solution_Information_Content_Entity
:Weaponeering_Solution_Information_Content_Entity rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://www.commoncoreontologies.org/ont00001808> ;
                                                                    owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000544>
                                                                  ] ;
                                                  rdfs:label "Weaponeering Solution Information Content Entity" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes the quantity of a specific type of lethal or nonlethal means required to create a desired effect on a given target." ;
                                                  <https://www.commoncoreontologies.org/ont00001745> "DoD Dictionary (2018)" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Aerial_Release
:Act_of_Aerial_Release rdf:type owl:Class ;
                       rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
                       rdfs:label "Act of Aerial Release" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Act of Aerial Release in which some Agent drops, dispenses, or discharges a material artifact from an aircraft or elevated platform into the air." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Battle_Damage_Assessment
:Act_of_Battle_Damage_Assessment rdf:type owl:Class ;
                                 rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000636> ;
                                 rdfs:label "Act of Battle Damage Assessment" ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "BDA" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "An Act of Appraisal that estimates the physical and functional damage resulting from the application of lethal or nonlethal millitary force." ;
                                 <https://www.commoncoreontologies.org/ont00001745> "CJCSI 3160.02A" .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Act_of_Bomb_Hit_Indication
:Act_of_Bomb_Hit_Indication rdf:type owl:Class ;
                            rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000636> ;
                            rdfs:label "Act of Bomb Hit Indication" ;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "BHI" ;
                            <http://www.w3.org/2004/02/skos/core#definition> "An Act of Appraisal used to indicate the damage to or a change of the physical state of target." ;
                            <https://www.commoncoreontologies.org/ont00001745> "CJCSI 3160.02A" .


