                        rdfs:label "Act of Tracking Target" ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "Tracking Phase" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "An Act of Intelligence in which the location and activity of an emerging target are repeatedly observed over a period of time, yielding updated location and vulnerability window information until the target is engaged or the act is ended." .


###  http://www.semanticweb.org/vlunc/ontologies/2026/9/DynamicTargeting/Aerial_Bomb
:Aerial_Bomb rdf:type owl:Class ;
             rdfs:subClassOf :Bomb ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
